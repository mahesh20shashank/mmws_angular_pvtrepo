SECRET_KEY="your-secret-key"
DEBUG=False
ALLOWED_HOSTS="your-host"

# Database: shares the existing swmm_30 Postgres instance/database, but lives
# in its own "document" schema. No other app should read/write this schema
# directly - only this service connects to it.
DB_NAME=swmm_30
DB_USER=your-user-name
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=document

# CORS / CSRF
CORS_ALLOWED_ORIGINS="your-server-ip"
CSRF_TRUSTED_ORIGINS="https://your-domain"
ENABLE_SWAGGER=False

# Local filesystem storage root. In docker-compose this is a mounted named
# volume so uploads persist across container restarts/redeploys.
STORAGE_ROOT=/data/files

# Service-to-service auth tolerance: max age (seconds) of an X-Timestamp
# header before a signed request is rejected as a possible replay.
SERVICE_AUTH_MAX_SKEW_SECONDS=300
