# =============================================================================
# document -- environment template
# -----------------------------------------------------------------------------
# Copy to .env and adjust:   cp .env.example .env
# .env is gitignored. Values below are safe local-development defaults.
#
# Shared document/file + PDF storage microservice used by SWMM (and ITTTM).
# It has NO local user model: callers authenticate with an HMAC-signed request
# (X-Service-Key / X-Timestamp / X-Signature). Per-client shared secrets live in
# this service's database (documents.ServiceClient), created via:
#   python manage.py create_service_client <client-name>
# so there is no client secret to put in this file.
# Dev port: 8090  ->  poetry run python manage.py runserver 8090
# =============================================================================

# --- Core Django -----------------------------------------------------------
# Has a dev default, but set your own for anything shared.
SECRET_KEY=dev-only-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Postgres; DB_USER / DB_PASSWORD required -- no sqlite fallback) -
# Shares the SAME Postgres database as SWMM / userauth, isolated in its own
# "document" schema. Only this service reads or writes that schema.
DB_NAME=swmm_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# search_path is set to "<DB_SCHEMA>,public". Default: document
# DB_SCHEMA=document

# --- File storage ----------------------------------------------------------
# Root directory for uploaded files; created on startup if missing. In
# docker-compose this is a mounted named volume so uploads survive restarts.
# Default: the project directory. On Windows dev use a real local path.
# STORAGE_ROOT=./data/files

# --- CORS / CSRF ---------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Swagger UI at /api/schema/swagger-ui/. Off by default.
ENABLE_SWAGGER=True

# --- Service-to-service HMAC auth ----------------------------------------------
# Max age (seconds) of an X-Timestamp header before a signed request is
# rejected as a possible replay. Default: 300
# SERVICE_AUTH_MAX_SKEW_SECONDS=300
