SECRET_KEY="your-secret-key"
DEBUG=False
ALLOWED_HOSTS="your-host"
SWMM_API_URL="http://[IP_ADDRESS]:8000"

# Database Configuration (uncomment and configure engine to use PostgreSQL, default is sqlite3)
# DB_ENGINE=django.db.backends.postgresql
DB_NAME=swmm
DB_USER=your-user-name
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432

# LDAP Configuration -- OPTIONAL now. LDAP/AD login moved to authz_service; these
# are only read by the legacy users.services AD/HRCDF provisioning helpers.
LDAP_SERVER=
LDAP_BASE_DN=

# ---------------------------------------------------------------------------
# authz_service integration (REQUIRED to run)
#
# SWMM is a pure resource server: it verifies RS256 bearers minted by
# authz_service (the userauth/ project) against the shared public key and
# issues none of its own. Run authz_service alongside SWMM.
# ---------------------------------------------------------------------------
# Base URL of the running authz_service. Dev default below; in docker-compose
# it is http://authz-service:8000.
AUTHZ_BASE_URL=http://localhost:8001
# Public key SWMM verifies tokens with. Leave unset to use the built-in default
# <repo-root>/keys/jwt_public.pem (generated by `userauth/gen_keys.py`).
# AUTHZ_JWT_PUBLIC_KEY_PATH=
# Seconds to cache a positive IsLiveAuthzUser / shadow-sync check.
AUTHZ_LIVE_CHECK_TTL=45
# Optional: share authz_service's Redis to skip the HTTP liveness probe.
# AUTHZ_REDIS_URL=redis://localhost:6379/0
# Shared secret for machine-to-machine calls -- MUST equal userauth/.env's value.
INTERNAL_SERVICE_KEY=dev-internal-key
# Optional JSON overriding authz role_code -> SWMM Role.role_name mapping.
# AUTHZ_ROLE_MAP={"HODWRITER": "HODWRITER"}

# HRCDF personnel lookup, queried after a successful AD bind at login to
# auto-provision the local account (users.services.save_hrcdf_to_db).
# Optional -- defaults to the Navy intranet endpoint if unset.
# HRCDF_API_URL="http://hrcdf.nausena.mil:10081/epps-cdf/personnelMaster/v1/personnel/lite"

# Developed with Understanding: HRCDF bulk roster sync (Administrator > HR CDF page). Every
# key is optional and shown with its default only. The defaults are the Navy NCN HRCDF lite
# roster; off that network the HR CDF page shows "HRCDF unreachable". Set HRCDF_SYNC_BASE_URL=
# (empty) to switch the sync off - it then answers "not configured". Never commit a real
# username or password here.
# HRCDF_SYNC_BASE_URL=http://hrcdf.nausena.mil:10081
# HRCDF_SYNC_USERS_PATH=/epps-cdf/personnelMaster/v1/personnel/lite
# HRCDF_SYNC_AUTH_TOKEN_PATH=/api/auth/token
# HRCDF_SYNC_AUTH_USERNAME=
# HRCDF_SYNC_AUTH_PASSWORD=
# HRCDF_SYNC_AUTH_TOKEN_KEY=token
# HRCDF_SYNC_AUTH_HEADER_SCHEME=Bearer
# HRCDF_SYNC_PAGE_PARAM=startIndex
# HRCDF_SYNC_PAGE_SIZE_PARAM=recordsPerPage
# HRCDF_SYNC_PAGE_SIZE=100
# HRCDF_SYNC_MAX_PAGES=1000
# HRCDF_SYNC_TIMEOUT_SECONDS=60
# HRCDF_SYNC_VERIFY_TLS=True
# HRCDF_SYNC_UNIT_FILTER_PARAM=
# HRCDF_SYNC_UNITS_PATH=
# HRCDF_SYNC_LOCK_TTL_SECONDS=21600

# CORS Configuration
CORS_ALLOWED_ORIGINS="your-server-ip"
CSRF_TRUSTED_ORIGINS="https://your-domain"
ENABLE_SWAGGER=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# CMMS Integration Configuration
API_KEY="your-api-key"
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM="HS256"
CELERY_BROKER_URL="redis://localhost:6379/2"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
REDIS_CACHE_URL="redis://localhost:6379/1"
