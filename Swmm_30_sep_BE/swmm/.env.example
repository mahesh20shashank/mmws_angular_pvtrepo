# =============================================================================
# SWMM backend -- environment template
# -----------------------------------------------------------------------------
# Copy to .env and adjust:   cp .env.example .env
# .env is gitignored. The values below are safe defaults for local development
# (DEBUG on, Postgres + Redis on localhost). Nothing here is a real secret.
#
# Sibling services in this repo (start all three for a full stack):
#   userauth/         -> authz_service, the login + token issuer (dev port 8001)
#   document/          -> shared file/PDF storage           (dev port 8090)
# Shared between services:
#   - keys/            RS256 key pair (repo root) -- generate via userauth/gen_keys.py
#   - INTERNAL_SERVICE_KEY   must be identical in swmm/.env and userauth/.env
#   - one Postgres database, one schema per service (swmm / UserAuth / document)
#   - CORS/CSRF origins must match the SPA origin listed in userauth/.env
# =============================================================================

# --- Core Django (all required) ----------------------------------------------
SECRET_KEY=dev-only-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Public base URL of THIS service. Used by the swmmapi CMMS-sync surface to
# build callback URLs. Required (no default).
SWMM_API_URL=http://127.0.0.1:8000

# --- Database (Postgres; required -- there is no sqlite fallback) ------------
DB_NAME=swmm_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# Postgres schema this service owns. search_path is set to this schema ONLY
# (public is excluded) so a database shared with userauth/document stays
# isolated. Default: swmm
# DB_SCHEMA=swmm
# CREATE SCHEMA IF NOT EXISTS on first connect. Default: same as DEBUG.
# Set False when the schema is provisioned out of band / the DB role lacks CREATE.
# DB_CREATE_SCHEMA=True

# --- authz_service integration ---------------------------------------------------
# SWMM is a pure resource server: it verifies RS256 bearers minted by
# authz_service and issues none of its own. Run userauth/ alongside SWMM.
AUTHZ_BASE_URL=http://localhost:8001
# Public key SWMM verifies tokens with. Default: <repo-root>/keys/jwt_public.pem
# AUTHZ_JWT_PUBLIC_KEY_PATH=
# Seconds to cache a positive live-user / shadow-sync check. Default: 45
# AUTHZ_LIVE_CHECK_TTL=45
# Optional: share authz_service's Redis to skip the HTTP liveness probe.
# AUTHZ_REDIS_URL=redis://localhost:6379/0
# Optional JSON overriding authz role_code -> SWMM Role.role_name mapping.
# AUTHZ_ROLE_MAP={"HODWRITER": "HODWRITER"}
# Shared secret for machine-to-machine calls -- MUST equal userauth/.env's value.
INTERNAL_SERVICE_KEY=dev-internal-key

# --- Redis / Celery --------------------------------------------------------------
# RabbitMQ has been dropped: Redis is broker + result backend + cache.
# Convention: DB 2 = broker, DB 0 = result backend, DB 1 = Django cache.
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
# Worker health-check tuning (endpoints fall back to synchronous execution when
# no worker answers within the timeout).
# CELERY_HEALTHCHECK_TIMEOUT=1.0
# CELERY_HEALTHCHECK_CACHE_TTL=5.0

# --- CORS / CSRF ---------------------------------------------------------------
# The SPA origin(s). Keep in sync with userauth/.env CORS_ALLOWED_ORIGINS.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Swagger UI at /api/schema/swagger-ui/. Off by default; handy in dev.
ENABLE_SWAGGER=True

# --- LDAP / HRCDF (optional) --------------------------------------------------
# LDAP/AD login moved to authz_service. These are only read by the legacy
# users.services AD/HRCDF auto-provisioning helpers.
# LDAP_SERVER=ldap://172.16.50.5:389
# LDAP_BASE_DN=ou=users,dc=example,dc=local
# HRCDF "lite" personnel lookup. Default: the Navy intranet endpoint.
# HRCDF_API_URL=http://hrcdf.nausena.mil:10081/epps-cdf/personnelMaster/v1/personnel/lite

# --- HRCDF bulk roster sync (optional) ------------------------------------------
# Developed with Understanding: read by accounts.hrcdf_client and accounts.hrcdf_sync for
# the Administrator > HR CDF page. Every key is shown with its default only. Leave
# HRCDF_SYNC_BASE_URL empty where HRCDF cannot be reached - the sync then answers
# "not configured". Set the NCN values at deployment. Never put a real credential here.
# HRCDF_SYNC_BASE_URL=
# HRCDF_SYNC_USERS_PATH=/api/users
# HRCDF_SYNC_AUTH_TOKEN_PATH=/api/auth/token
# HRCDF_SYNC_AUTH_USERNAME=
# HRCDF_SYNC_AUTH_PASSWORD=
# HRCDF_SYNC_AUTH_TOKEN_KEY=token
# HRCDF_SYNC_AUTH_HEADER_SCHEME=Bearer
# HRCDF_SYNC_PAGE_PARAM=page
# HRCDF_SYNC_PAGE_SIZE_PARAM=pageSize
# HRCDF_SYNC_PAGE_SIZE=500
# HRCDF_SYNC_MAX_PAGES=1000
# HRCDF_SYNC_TIMEOUT_SECONDS=60
# HRCDF_SYNC_VERIFY_TLS=True
# Query parameter that narrows an own-ship run to the home unit code. Empty = no filter.
# HRCDF_SYNC_UNIT_FILTER_PARAM=
# HRCDF unit list path for Get Ship Names. Empty = units come from the seed and roster.
# HRCDF_SYNC_UNITS_PATH=
# HRCDF_SYNC_LOCK_TTL_SECONDS=21600

# --- Active-ship fallback (optional) ----------------------------------------
# Used by master.utils.get_this_ship() only when no ActiveShipConfig row exists.
# DEFAULT_SHIP_ID=
# SHIP_ID=
# SWMM_SHIP_CODE=L18

# --- CMMS integration (optional; swmmapi / sfd / srar sync surface only) -----
# Legacy MSSQL CMMS. All have code defaults; set them only if CMMS sync is used.
# CMMS_DB_DRIVER=SQL Server
# CMMS_DB_HOST=172.16.40.12
# CMMS_DB_PORT=1433
# CMMS_DB_NAME=CMMSDUMMY
# CMMS_DB_USER=
# CMMS_DB_PASSWORD=

# --- Production-only hardening ----------------------------------------------
# In dev these derive from DEBUG and can be left unset. Set explicitly in prod.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
