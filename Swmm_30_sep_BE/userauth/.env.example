# =============================================================================
# authz_service (userauth/) -- environment template
# -----------------------------------------------------------------------------
# Copy to .env and adjust:   cp .env.example .env
# .env is gitignored and never required in production (env vars may come from
# the orchestrator instead). Settings fail fast on missing secrets outside DEBUG.
#
# This service is the fleet's ONLY login surface: the SPA authenticates here and
# receives an RS256 bearer that SWMM (and other services) verify offline.
# Shared with the SWMM service:
#   - keys/                  RS256 + login key pairs (repo root) -- see "Keys" below
#   - INTERNAL_SERVICE_KEY   must be identical in userauth/.env and swmm/.env
#   - CORS_ALLOWED_ORIGINS   must list the same SPA origin SWMM allows
#   - one Postgres database, isolated by schema (this service owns "UserAuth")
# Dev port: 8001  ->  poetry run python manage.py runserver 8001
# =============================================================================

# --- Core Django ------------------------------------------------------------
DEBUG=True
# Required outside DEBUG (fail-fast). The value below is a throwaway dev secret.
DJANGO_SECRET_KEY=dev-only-insecure-change-me
DJANGO_ALLOWED_HOSTS=*
# SERVICE_NAME=authz_service
# LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------------
# Leave every DB_* unset to use a local sqlite file (fine for a fresh checkout
# and for tests). For a real deployment, point at the SAME Postgres database as
# SWMM -- this service is isolated in its own schema (public is kept off the
# search_path so migration history never collides).
# DB_NAME=swmm_dev
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_SCHEMA=UserAuth
# CREATE SCHEMA IF NOT EXISTS on first connect. Default: same as DEBUG.
# Set False when the schema is provisioned out of band / the DB role lacks CREATE.
# DB_CREATE_SCHEMA=True

# --- Keys -- RS256 (token signing) + RSA-OAEP (login password decryption) ------
# The service SIGNS tokens; every service VERIFIES them. Key files must exist on
# disk at startup or the service refuses to boot. Generate all four PEMs with:
#   poetry run python gen_keys.py
# A relative KEYS_DIR resolves against the userauth/ project root, so "../keys"
# is the shared repo-root keys/ dir that SWMM also reads.
KEYS_DIR=../keys
# Override individual paths only if they live outside KEYS_DIR:
# JWT_PRIVATE_KEY_PATH=
# JWT_PUBLIC_KEY_PATH=
# LOGIN_PRIVATE_KEY_PATH=
# LOGIN_PUBLIC_KEY_PATH=
# Require RSA-OAEP decryption of the login password. Mandatory outside DEBUG;
# a decrypt failure is always a rejected login, never a plaintext fallback.
LOGIN_DECRYPTION_REQUIRED=False

# --- Token lifetimes ---------------------------------------------------------
# ACCESS_TOKEN_LIFETIME_MIN=20
# REFRESH_TOKEN_LIFETIME_HOURS=12
# Only one active session per user: a new login ends every other session and
# blacklists their outstanding refresh tokens. Default: True.
# ENFORCE_SINGLE_SESSION=True

# --- Redis / Celery --------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
# Use local-memory cache instead of Redis (dev boxes / CI without Redis).
# Default: same as DEBUG. Set False to actually use REDIS_URL for the cache.
USE_LOCMEM_CACHE=True
# USER_PROFILE_CACHE_TTL=900
# Both default to REDIS_URL.
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# CELERY_TASK_ALWAYS_EAGER=False
# DELEGATION_LIFECYCLE_INTERVAL_SECONDS=60

# --- CORS / CSRF ---------------------------------------------------------------
# The browser origin(s) the SPA is served from. The SPA logs in here directly,
# so its origin MUST be listed or the CORS preflight is refused.
# Keep in sync with swmm/.env CORS_ALLOWED_ORIGINS.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Defaults to CORS_ALLOWED_ORIGINS.
# CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Audit service (best-effort POST of an audit trail) ---------------------
# Default: same as (not DEBUG). If enabled, AUDIT_SERVICE_URL is required.
AUDIT_ENABLED=False
# AUDIT_SERVICE_URL=
AUDIT_SERVICE_KEY=dev-audit-key
# AUDIT_HTTP_TIMEOUT=2.0

# --- Shared service-to-service secret (MUST match swmm/.env) ----------------
INTERNAL_SERVICE_KEY=dev-internal-key

# --- ITTTM user sync (best-effort POST of seed_rbac's ship/unit accounts) ---
# itttm_backend_microservice's user_service signup endpoint. Only the 16
# accounts in seed_rbac.py's ADMIN_PASSWORD_USERNAMES are pushed.
# ITTTM_USER_SERVICE_URL="http://127.0.0.1:8000/api/auth/swmm-user-signup/"
# ITTTM_USER_SERVICE_KEY=""

# --- LDAP (optional) -------------------------------------------------------------
# When off, ad_user accounts fall back to the local password hash.
LDAP_AUTH=False
# LDAP_SERVER_URI=ldap://172.16.50.5:389
# LDAP_BIND_DOMAIN=example.local

# --- HRCDF (optional) --------------------------------------------------------------
# Per-login personnel lookup for rank/designation/unit. Blank disables it.
# HRCDF_URL=http://hrcdf.nausena.mil:10081/epps-cdf/personnelMaster/v1/personnel/lite
