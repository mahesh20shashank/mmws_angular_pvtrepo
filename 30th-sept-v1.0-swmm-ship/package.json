{
    "name": "swmm-ship",
    "version": "1.0.0",
    "description": "Repo root. The Angular workspace lives in frontend/ — these scripts forward to it so npm commands work from either directory.",
    "private": true,
    "scripts": {
        "postinstall": "npm --prefix frontend install",
        "start": "npm --prefix frontend start",
        "setup": "npm --prefix frontend install",
        "build": "npm --prefix frontend run build",
        "build:dev": "npm --prefix frontend run build:dev",
        "build:uat": "npm --prefix frontend run build:uat",
        "build:prod": "npm --prefix frontend run build:prod",
        "watch": "npm --prefix frontend run watch",
        "test": "npm --prefix frontend test",
        "lint": "npm --prefix frontend run lint"
    }
}
